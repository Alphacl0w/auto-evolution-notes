---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectTerms, getPublishedPosts, termUrl } from '../../utils';

const posts = await getPublishedPosts();
const tags = collectTerms(posts, (post) => post.data.tags);
---

<BaseLayout title="标签" description="AI Agent 实验室的文章标签索引。">
  <section class="page-head">
    <p class="eyebrow">Tags</p>
    <h1>标签</h1>
    <p>快速定位工具、框架、部署和运营主题。</p>
  </section>
  <div class="term-list">
    {tags.map(({ term, count }) => <a href={termUrl('tags', term)}>{term}<span>{count}</span></a>)}
  </div>
</BaseLayout>
