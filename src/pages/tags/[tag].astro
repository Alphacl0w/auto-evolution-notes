---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { collectTerms, getPublishedPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return collectTerms(posts, (post) => post.data.tags).map(({ term }) => ({
    params: { tag: encodeURIComponent(term) },
    props: { tag: term, posts: posts.filter((post) => post.data.tags.includes(term)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`${tag} 标签下的文章。`}>
  <section class="page-head">
    <p class="eyebrow">Tag</p>
    <h1>#{tag}</h1>
  </section>
  <section class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
