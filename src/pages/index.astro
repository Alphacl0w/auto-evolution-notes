---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, TRACKS } from '../site';
import { getPublishedPosts } from '../utils';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 3);
const agentMemoryPosts = posts.filter((post) => post.data.track === 'agent-memory').slice(0, 3);
const securityPosts = posts.filter((post) => post.data.track === 'security').slice(0, 3);
const aiNativePracticePosts = posts.filter((post) => post.data.track === 'ai-native-practice').slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  inLanguage: SITE.locale,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
  },
};
---

<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow">Research Notes</p>
      <h1>长期研究 AI 记忆系统、AI Native 实践与安全工程。</h1>
      <p>
        这里不追热点口号，只拆解能落到工程里的技术问题：Agent Memory、AI Native 工作流，以及白盒扫描、代码图、静态分析和安全自动化。
      </p>
      <div class="hero__actions">
        <a class="button" href="/articles/">进入文章库</a>
        <a class="button button--ghost" href="/research/">研究方向</a>
      </div>
    </div>
    <div class="hero__visual" aria-label="AI 记忆系统研究示意">
      <div class="signal-grid">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="console-panel">
        <b>memory-system.map</b>
        <code>episodic: events + traces</code>
        <code>semantic: facts + abstractions</code>
        <code>retrieval: relevance + freshness</code>
        <code>forgetting: decay + conflict checks</code>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__heading">
      <p class="eyebrow">Research Tracks</p>
      <h2>三个长期分支</h2>
      <a href="/research/">查看方向</a>
    </div>
    <div class="track-grid">
      <a class="track-card" href="/research/agent-memory/">
        <span>{TRACKS['agent-memory'].label}</span>
        <h3>{TRACKS['agent-memory'].title}</h3>
        <p>{TRACKS['agent-memory'].description}</p>
        <small>{agentMemoryPosts.length} 篇近期文章</small>
      </a>
      <a class="track-card" href="/research/security/">
        <span>{TRACKS.security.label}</span>
        <h3>{TRACKS.security.title}</h3>
        <p>{TRACKS.security.description}</p>
        <small>{securityPosts.length} 篇近期文章</small>
      </a>
      <a class="track-card" href="/research/ai-native-practice/">
        <span>{TRACKS['ai-native-practice'].label}</span>
        <h3>{TRACKS['ai-native-practice'].title}</h3>
        <p>{TRACKS['ai-native-practice'].description}</p>
        <small>{aiNativePracticePosts.length} 篇近期文章</small>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="section__heading">
      <p class="eyebrow">Research Archive</p>
      <h2>研究文章</h2>
      <a href="/articles/">全部文章</a>
    </div>
    {
      latest.length > 0 ? (
        <div class="post-grid">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="empty-state">
          <h3>首批研究文章整理中。</h3>
          <p>这里将只发布有论文来源、源码依据或工程实验支撑的 AI 记忆系统研究文章。</p>
        </div>
      )
    }
  </section>

  <section class="band">
    <div>
      <p class="eyebrow">Research Standard</p>
      <h2>没有可靠材料，就不强行更新。</h2>
    </div>
    <ul class="rule-list">
      <li>论文文章必须说明问题背景、核心方法、实验结论和局限。</li>
      <li>开源项目分析必须读源码、看接口和运行路径，避免只复述 README。</li>
      <li>实践方案必须写清适用场景、执行步骤、人工审核点、失败模式和可验证指标。</li>
    </ul>
  </section>

  <section class="section">
    <div class="section__heading">
      <p class="eyebrow">Focus Areas</p>
      <h2>长期关注的问题</h2>
    </div>
    <div class="topic-list">
      <span>Long-term memory</span>
      <span>Memory-augmented RAG</span>
      <span>Context compression</span>
      <span>Retrieval evaluation</span>
      <span>Forgetting and conflict</span>
      <span>Personalization memory</span>
      <span>Code Property Graph</span>
      <span>White-box scanning</span>
      <span>Static analysis</span>
      <span>Agent security</span>
      <span>AI Native workflow</span>
      <span>Agentic automation</span>
      <span>Human-in-the-loop review</span>
    </div>
  </section>
</BaseLayout>
