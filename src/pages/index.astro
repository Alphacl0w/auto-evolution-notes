---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../site';
import { getPublishedPosts } from '../utils';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  inLanguage: SITE.locale,
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
  },
};
---

<BaseLayout title={SITE.name} description={SITE.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow">AI Memory Research Notes</p>
      <h1>系统研究 AI 记忆：论文、源码、架构和可复现实验。</h1>
      <p>
        这里不追热点口号，只拆解能落到工程里的记忆机制：长期记忆、RAG、向量检索、上下文压缩、遗忘策略、个人化记忆和评测方法。
      </p>
      <div class="hero__actions">
        <a class="button" href="/articles/">进入文章库</a>
        <a class="button button--ghost" href="/about/">研究边界</a>
      </div>
    </div>
    <div class="hero__visual" aria-label="AI 记忆系统研究示意">
      <div class="signal-grid">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="console-panel">
        <b>memory-system.map</b>
        <code>episodic: events + traces</code>
        <code>semantic: facts + abstractions</code>
        <code>retrieval: relevance + freshness</code>
        <code>forgetting: decay + conflict checks</code>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__heading">
      <p class="eyebrow">Research Archive</p>
      <h2>研究文章</h2>
      <a href="/articles/">全部文章</a>
    </div>
    {
      latest.length > 0 ? (
        <div class="post-grid">
          {latest.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="empty-state">
          <h3>首批研究文章整理中。</h3>
          <p>这里将只发布有论文来源、源码依据或工程实验支撑的 AI 记忆系统研究文章。</p>
        </div>
      )
    }
  </section>

  <section class="band">
    <div>
      <p class="eyebrow">Research Standard</p>
      <h2>没有可靠材料，就不强行更新。</h2>
    </div>
    <ul class="rule-list">
      <li>论文文章必须说明问题背景、核心方法、实验结论和局限。</li>
      <li>开源项目分析必须读源码、看接口和运行路径，避免只复述 README。</li>
      <li>优化建议必须写清适用场景、代价、失败模式和可验证指标。</li>
    </ul>
  </section>

  <section class="section">
    <div class="section__heading">
      <p class="eyebrow">Focus Areas</p>
      <h2>长期关注的问题</h2>
    </div>
    <div class="topic-list">
      <span>Long-term memory</span>
      <span>Memory-augmented RAG</span>
      <span>Context compression</span>
      <span>Retrieval evaluation</span>
      <span>Forgetting and conflict</span>
      <span>Personalization memory</span>
    </div>
  </section>
</BaseLayout>
